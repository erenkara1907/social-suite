# ═══════════════════════════════════════════════════════════════════════════
#  .env.example — üç projenin env union'ı, BIRLESIM_PLANI §1.12 kararlarıyla
#
#  TEMEL KURAL (§1.12 / §8.6):
#  Müşteriye ait AI sağlayıcı anahtarları BURADA DEĞİL, `provider_credentials`
#  tablosunda + Supabase Vault'ta yaşar. Ürün tanımı "müşteri kendi anahtarını
#  girer" diyor; env'den okunan bir anahtar tüm müşteriler için ortak olurdu.
#
#  Bu dosyaya gerçek anahtar YAZILMAZ. `.env.local` .gitignore'da.
# ═══════════════════════════════════════════════════════════════════════════


# ── 1. UYGULAMA ────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Genel mod bayrağı: demo | live   (§9.1)
# Port başına ezme: MODE_PLANNER=live, MODE_PUBLISHER=demo, …
# Varsayılan "demo" — bilinmeyen durumda sahte veri göstermek, gerçek para
# harcamaktan iyidir. NEXT_PUBLIC_ DEĞİL: sunucuda çözülür, runtime'da değişir.
APP_MODE=demo


# ── 2. SUPABASE (zorunlu) ──────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ⚠ RLS'i BAYPAS EDER. Yalnızca üç yerde kullanılır (lib/server/README.md):
#   cron job'ları · OAuth callback · credential okuması
SUPABASE_SERVICE_ROLE_KEY=


# ── 3. ZAMANLAYICI ─────────────────────────────────────────────────────────
# pg_cron → /api/cron/* çağrılarının Bearer token'ı.
# 00_schema.sql §10'daki __CRON_SECRET__ placeholder'ı ile AYNI değer olmalı.
CRON_SECRET=


# ── 4. INSTAGRAM — ⚠ YALNIZCA FALLBACK (D2) ────────────────────────────────
#
#  D2 kararı: Instagram uygulama kimlikleri MARKA BAZLIDIR ve öncelikle
#  `provider_credentials` (provider='instagram') satırından okunur.
#  Aşağıdaki değerler YALNIZCA markanın satırı yoksa devreye girer.
#
#  MVP'de her marka bu fallback'i kullanır: tek Meta uygulaması + müşteriler
#  tester olarak ekleniyor (limit ~25). App Review başvurusu paralel yürüyor.
#  App Review çıktığında veya bir müşteri kendi Meta uygulamasını getirdiğinde
#  o markanın satırı yazılır ve fallback devreden çıkar — şema değişmez.
#
#  ⚠ `lib/providers/instagram/config.ts` bu değerleri KENDİSİ OKUMAZ.
#     Okuma `lib/server/`'da yapılır, config'e parametre olarak geçer (§8.6).
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# Meta panelindeki redirect listesi ne gösteriyorsa birebir o (sondaki / dahil)
INSTAGRAM_REDIRECT_URI=
# Boş bırakılırsa v23.0 kullanılır
INSTAGRAM_API_VERSION=


# ── 5. AI SAĞLAYICILARI — ⚠ BURADA DEĞİL ───────────────────────────────────
#
#  Aşağıdakiler ÜÇ PROJEDE DE env'de duruyordu ve birleşimde env'DEN ÇIKTI:
#
#     ANTHROPIC_API_KEY     → provider_credentials (provider='anthropic')
#     KIE_API_KEY           → provider_credentials (provider='kie')
#     ELEVENLABS_API_KEY    → provider_credentials (provider='elevenlabs')
#     FAL_KEY               → provider_credentials (provider='fal')
#     VOYAGE_API_KEY        → provider_credentials (provider='voyage')
#
#  Anahtarın kendisi tabloda bile durmuyor — Supabase Vault'ta duruyor, tablo
#  yalnızca `vault_secret_id` taşıyor (§5). İki kat koruma.
#
#  Buraya bir AI anahtarı eklemek, o anahtarı TÜM müşteriler için ortak yapar
#  ve faturayı bize bindirir. Yapma.


# ── 6. ÖZELLİK BAYRAKLARI ──────────────────────────────────────────────────
# sahne'den geldi. UGC boru hattı §12 adım 20'de canlıya alınır.
PERSONA_PIPELINE_ENABLED=false

# ffmpeg kararı (§10): MVP'de KAPALI. Vercel'de ffmpeg binary'si yok.
# Açıksa ve çalışmıyorsa artık SESSİZCE YUTULMAZ — log'a düşer.
PERSONA_PHONE_EFFECT=false


# ── 7. TAŞINMAYANLAR ───────────────────────────────────────────────────────
# RESEND_API_KEY — siraya'da tanımlıydı ama hiçbir yerde kullanılmıyordu
#                  (KESIF_SIRAYA §4). Davet e-postası akışı organizasyon
#                  katmanıyla birlikte gelecek (§11 S2: ERTELENDİ).
